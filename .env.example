OPENROUTER_API_KEY=sk-or-...
# Optional: the key for the `openai:` scheme.
OPENAI_API_KEY=
RA_MODEL=openrouter:anthropic/claude-sonnet-5
RA_JUDGE_MODEL=openrouter:openai/gpt-5.4-mini
# A tier on the ChatGPT subscription: run `codex login` first, then name the model with `chatgpt:`.
# RA_MODEL=chatgpt:gpt-5.5
# Where the Codex CLI keeps the Sign-in; the default is the CLI's own directory.
# CODEX_HOME=~/.codex
# How the Kernel names itself to the ChatGPT backend, in the `originator` header.
# RA_CHATGPT_ORIGINATOR=recursive_application
# Optional: set to send traces to Logfire cloud as well as the local trace store.
LOGFIRE_TOKEN=
